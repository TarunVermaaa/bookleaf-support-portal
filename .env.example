# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Leave empty for local development: the server uses an embedded Postgres (PGlite) stored in server/.pglite.
# In production set a real Postgres connection string.
DATABASE_URL=

# --- Auth ---
# Any long random string. Used to sign the session JWT (stored in an httpOnly cookie).
JWT_SECRET=change-me-to-a-long-random-string

# --- AI ---
# Anthropic API key. Only read on the server; never sent to the browser.
# If empty, the app still works: triage falls back to keyword rules and admins write replies manually.
ANTHROPIC_API_KEY=
# Model used for triage and drafts. claude-haiku-5-5 is a cheaper option for this workload.
AI_MODEL=claude-opus-5-5

# --- Server ---
PORT=4000
NODE_ENV=development
# Seed the sample dataset on first boot when the database is empty (true/false)
SEED_ON_BOOT=true
